#!/usr/bin/env bash
# idol-view: open .ply splats in a local browser viewer. Wrapper around the installed console script (or the module) in the project venv.
# Run scripts/setup.sh first, or: pip install -e ".[view]"
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
venv="$here/.venv"
if [ ! -x "$venv/bin/python" ]; then
  echo "error: no .venv here — run scripts/setup.sh, or: pip install -e \".[view]\"" >&2
  exit 1
fi
export PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1
if [ -x "$venv/bin/idol-view" ]; then exec "$venv/bin/idol-view" "$@"; fi
exec "$venv/bin/python" -m idol_tools.viewer "$@"
