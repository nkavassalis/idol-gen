#!/usr/bin/env bash
# idol-mesh: convert .ply splats into printable .stl / .obj / .ply meshes. Wrapper around the installed console script (or the module) in the project venv.
# Run scripts/setup.sh --mesh first, or: pip install -e ".[mesh]"
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
venv="$here/.venv"
if [ ! -x "$venv/bin/python" ]; then
  echo "error: no .venv here — run scripts/setup.sh --mesh, or: pip install -e \".[mesh]\"" >&2
  exit 1
fi
export PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1
if [ -x "$venv/bin/idol-mesh" ]; then exec "$venv/bin/idol-mesh" "$@"; fi
exec "$venv/bin/python" -m idol_tools.mesh "$@"
